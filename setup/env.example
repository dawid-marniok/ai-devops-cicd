# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore i nie trafi do repo.
# Wartości dostaniesz od prowadzącego. Wczytanie w terminalu:
#   set -a; source .env; set +a

# Twój identyfikator — nazwa Twojego namespace'u w klastrze i prefiks tagów obrazów.
# Małe litery i myślniki, bez polskich znaków. Np. "anna-k".
UCZESTNIK=

# Rejestr obrazów — pełny adres repozytorium BEZ tagu, np.
# 123456789012.dkr.ecr.eu-central-1.amazonaws.com/quotes-api
# W zsh pisz ${ECR_REPO}:tag — samo $ECR_REPO:tag psuje się dla tagów na t/h/u/r/e.
ECR_REPO=

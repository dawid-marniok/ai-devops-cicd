{
  "permissions": {
    "allow": [
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(tflint:*)",
      "Bash(checkov:*)",
      "Bash(trivy:*)",
      "Bash(conftest:*)",
      "Bash(actionlint:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl argo rollouts get:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm:*)",
      "Bash(aws:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.tfvars)",
      "Read(./**/credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/blokuj-sekrety.sh"
          }
        ]
      }
    ]
  }
}

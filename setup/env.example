# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore i nie trafi do repo.
# Wartości dostaniesz od prowadzącego na początku dnia 1.

# Twój identyfikator — wchodzi w nazwy zasobów i w nazwę namespace'u.
# Małe litery i myślniki, bez polskich znaków. Np. "anna-k".
UCZESTNIK=

# AWS — konto szkoleniowe, nie produkcyjne
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Rejestr obrazów — adres przekazuje prowadzący.
ECR_REPO=

# Klaster (dzień 2) — kubeconfig pobierzesz komendą z setup/README.md
EKS_CLUSTER=szkolenie-ai-devops
K8S_NAMESPACE=

# Vault (blok dodatkowy) — lokalny serwer dev, adres z terminala prowadzącego
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# Feature-flagi (dzień 2). Puste = aplikacja czyta flagi z pliku app/flags.json.
FLAGD_HOST=
FLAGD_PORT=8013
